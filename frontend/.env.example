# Local: aponta direto para a API.
VITE_API_URL=http://localhost:3000/api

# Transporte da sessão: cookie (padrão) | bearer (workaround cross-domain)
# Deve coincidir com AUTH_TRANSPORT no backend.
# VITE_AUTH_TRANSPORT=cookie

# Produção (Vercel): URL completa da API no Railway (sem proxy).
# Defina em Environment Variables do projeto Vercel e redeploy após alterar.
# VITE_API_URL=https://gestao-amaitajai-production.up.railway.app/api
