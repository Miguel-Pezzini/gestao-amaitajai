# Copie para .env: cp .env.example .env  (na pasta backend)

# PostgreSQL (Docker)
POSTGRES_CONTAINER_NAME=gestao-amaitajai-postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gestao_amaitajai

# URI para o Express / Prisma
DATABASE_URL=postgresql://admin:changeme@localhost:5432/gestao_amaitajai
DIRECT_URL=postgresql://admin:changeme@localhost:5432/gestao_amaitajai

# PostgreSQL exclusivo para testes (Docker)
POSTGRES_TEST_CONTAINER_NAME=gestao-amaitajai-postgres-test
POSTGRES_TEST_PORT=5433
POSTGRES_TEST_USER=admin
POSTGRES_TEST_PASSWORD=changeme
POSTGRES_TEST_DB=gestao_amaitajai_test
TEST_DATABASE_URL=postgresql://admin:changeme@localhost:5433/gestao_amaitajai_test

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Produção (Railway): URL exata do frontend na Vercel (sem barra final).
# CORS_ORIGIN=https://seu-app.vercel.app
NODE_ENV=development
# Limite de tentativas de login por IP (desativado automaticamente em NODE_ENV=test)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# JWT (cookie httpOnly)
JWT_SECRET=troque-por-uma-chave-segura-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=ama_access_token
JWT_COOKIE_MAX_AGE_MS=28800000
# lax (local) | strict (mesmo domínio) | none (produção: frontend Vercel + API Railway)
COOKIE_SAME_SITE=lax
# Produção (Railway): obrigatório para sessão cross-domain (Vercel → Railway).
# COOKIE_SAME_SITE=none
BCRYPT_SALT_ROUNDS=12
TEST_BCRYPT_SALT_ROUNDS=4

# Usuário inicial (seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@amaitajai.org.br
ADMIN_PASSWORD=troque-esta-senha

# Domínio institucional permitido no login
ALLOWED_EMAIL_DOMAIN=amaitajai.org.br

# Google OAuth (login corporativo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Produção (Railway): callback no domínio da API (não use URL da Vercel).
# GOOGLE_REDIRECT_URI=https://gestao-amaitajai-production.up.railway.app/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
# Produção (Railway): URL do frontend na Vercel (redirects pós-login OAuth).
# FRONTEND_URL=https://seu-app.vercel.app
