# Copie para .env: cp .env.example .env  (na pasta backend)

# MongoDB (Docker)
MONGO_CONTAINER_NAME=gestao-amaitajai-mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=gestao_amaitajai

# URI para o Express / Mongoose
MONGODB_URI=mongodb://admin:changeme@localhost:27017/gestao_amaitajai?authSource=admin

# MongoDB exclusivo para testes (Docker)
MONGO_TEST_CONTAINER_NAME=gestao-amaitajai-mongo-test
MONGO_TEST_PORT=27018
MONGO_TEST_INITDB_ROOT_USERNAME=admin
MONGO_TEST_INITDB_ROOT_PASSWORD=changeme
MONGO_TEST_INITDB_DATABASE=gestao_amaitajai_test
TEST_MONGODB_URI=mongodb://admin:changeme@localhost:27018/gestao_amaitajai_test?authSource=admin

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# JWT (cookie httpOnly)
JWT_SECRET=troque-por-uma-chave-segura-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=ama_access_token
JWT_COOKIE_MAX_AGE_MS=28800000
BCRYPT_SALT_ROUNDS=12
TEST_BCRYPT_SALT_ROUNDS=4

# Usuário inicial (seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@amaitajai.org.br
ADMIN_PASSWORD=troque-esta-senha
