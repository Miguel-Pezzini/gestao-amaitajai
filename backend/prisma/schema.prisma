generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMINISTRADOR
  TECNICO
}

enum UserAccountStatus {
  PENDENTE
  ATIVO
  INATIVO
}

enum FundingSource {
  MUNICIPAL
  ESTADUAL
  PARTICULAR
}

enum SessionModality {
  INDIVIDUAL
  DUPLA
  GRUPO
}

enum SessionStatus {
  AGENDADA
  REALIZADA
  CANCELADA
}

enum ProtocolStatus {
  PENDENTE
  CONCLUIDO
}

enum SessionSeriesStatus {
  ATIVA
  ENCERRADA
  CANCELADA
}

model User {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  email         String            @unique
  passwordHash  String?
  googleId      String?           @unique
  role          UserRole          @default(TECNICO)
  accountStatus UserAccountStatus @default(ATIVO)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  sessionsCreated           Session[]                 @relation("SessionCreatedBy")
  sessionsUpdated           Session[]                 @relation("SessionUpdatedBy")
  sessionProfessionals      SessionProfessional[]
  sessionSeriesCreated      SessionSeries[]           @relation("SessionSeriesCreatedBy")
  sessionSeriesUpdated      SessionSeries[]           @relation("SessionSeriesUpdatedBy")
  sessionSeriesProfessional SessionSeriesProfessional[]
  protocolsCreated          PatientProtocol[]         @relation("ProtocolCreatedBy")
  protocolsUpdated          PatientProtocol[]         @relation("ProtocolUpdatedBy")

  @@index([role, accountStatus])
}

model Patient {
  id            String        @id @default(uuid()) @db.Uuid
  fullName      String
  birthDate     DateTime      @db.Date
  guardianName  String
  phone         String
  fundingSource FundingSource
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sessionPatients       SessionPatient[]
  sessionSeriesPatients SessionSeriesPatient[]
  protocols             PatientProtocol[]

  @@index([isActive, fullName])
  @@index([fundingSource, isActive, fullName])
}

model ProtocolType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocols PatientProtocol[]

  @@index([isActive])
}

model PatientProtocol {
  id             String         @id @default(uuid()) @db.Uuid
  protocolNumber Int            @unique
  patientId      String         @db.Uuid
  protocolTypeId String         @db.Uuid
  status         ProtocolStatus @default(PENDENTE)
  notes          String         @default("")
  createdById    String         @db.Uuid
  updatedById    String         @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id])
  protocolType ProtocolType @relation(fields: [protocolTypeId], references: [id])
  createdBy    User         @relation("ProtocolCreatedBy", fields: [createdById], references: [id])
  updatedBy    User         @relation("ProtocolUpdatedBy", fields: [updatedById], references: [id])

  @@index([patientId, status])
  @@index([status, createdAt])
  @@index([protocolNumber])
  @@index([protocolTypeId])
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  sessionSeries  SessionSeries[]

  @@index([isActive])
}

model SessionType {
  id                     String            @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String            @unique
  defaultDurationMinutes Int
  isDurationFlexible     Boolean           @default(false)
  allowedModalities      SessionModality[]
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  sessions      Session[]
  sessionSeries SessionSeries[]

  @@index([name])
  @@index([isActive])
}

model SessionSeries {
  id              String              @id @default(uuid()) @db.Uuid
  sessionTypeId   String              @db.Uuid
  modality        SessionModality
  roomId          String              @db.Uuid
  weekdays        Int[]
  startsAt        DateTime            @db.Date
  endsAt          DateTime            @db.Date
  timeMinutes     Int
  durationMinutes Int
  status          SessionSeriesStatus @default(ATIVA)
  notes           String              @default("")
  createdById     String              @db.Uuid
  updatedById     String              @db.Uuid
  cancelledAt     DateTime?
  cancelReason    String              @default("")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  sessionType   SessionType                 @relation(fields: [sessionTypeId], references: [id])
  room          Room                        @relation(fields: [roomId], references: [id])
  createdBy     User                        @relation("SessionSeriesCreatedBy", fields: [createdById], references: [id])
  updatedBy     User                        @relation("SessionSeriesUpdatedBy", fields: [updatedById], references: [id])
  patients      SessionSeriesPatient[]
  professionals SessionSeriesProfessional[]
  sessions      Session[]

  @@index([status])
  @@index([startsAt, endsAt])
}

model SessionSeriesPatient {
  seriesId  String @db.Uuid
  patientId String @db.Uuid

  series  SessionSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id])

  @@id([seriesId, patientId])
  @@index([patientId])
}

model SessionSeriesProfessional {
  seriesId       String @db.Uuid
  professionalId String @db.Uuid

  series       SessionSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  professional User          @relation(fields: [professionalId], references: [id])

  @@id([seriesId, professionalId])
  @@index([professionalId])
}

model Session {
  id              String          @id @default(uuid()) @db.Uuid
  seriesId        String?         @db.Uuid
  sessionTypeId   String          @db.Uuid
  modality        SessionModality
  roomId          String          @db.Uuid
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  status          SessionStatus   @default(AGENDADA)
  notes           String          @default("")
  createdById     String          @db.Uuid
  updatedById     String          @db.Uuid
  cancelledAt     DateTime?
  cancelReason    String          @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  series        SessionSeries?        @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  sessionType   SessionType           @relation(fields: [sessionTypeId], references: [id])
  room          Room                  @relation(fields: [roomId], references: [id])
  createdBy     User                  @relation("SessionCreatedBy", fields: [createdById], references: [id])
  updatedBy     User                  @relation("SessionUpdatedBy", fields: [updatedById], references: [id])
  patients      SessionPatient[]
  professionals SessionProfessional[]

  @@index([startAt, endAt])
  @@index([roomId, startAt, endAt])
  @@index([status])
  @@index([seriesId, startAt])
}

model SessionPatient {
  sessionId String @db.Uuid
  patientId String @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])

  @@id([sessionId, patientId])
  @@index([patientId])
}

model SessionProfessional {
  sessionId      String @db.Uuid
  professionalId String @db.Uuid

  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  professional User    @relation(fields: [professionalId], references: [id])

  @@id([sessionId, professionalId])
  @@index([professionalId])
}

model SessionModalitySetting {
  id               String          @id @default(uuid()) @db.Uuid
  modality         SessionModality @unique
  minPatients      Int
  maxPatients      Int
  minProfessionals Int
  maxProfessionals Int
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([isActive])
}
